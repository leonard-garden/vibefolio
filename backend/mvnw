# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script
# ----------------------------------------------------------------------------

# Determine the script directory
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-.}"
MAVEN_WRAPPER_JAR="${MAVEN_PROJECTBASEDIR}/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="${MAVEN_PROJECTBASEDIR}/.mvn/wrapper/maven-wrapper.properties"

# Find java executable
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVACMD" ]; then
        echo "The JAVA_HOME environment variable is not defined correctly" >&2
        echo "Cannot execute: $JAVACMD" >&2
        exit 1
    fi
else
    JAVACMD="java"
    if ! command -v java > /dev/null 2>&1; then
        echo "The JAVA_HOME environment variable is not defined and no 'java' command found in PATH." >&2
        exit 1
    fi
fi

# Download wrapper jar if not present
if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
    WRAPPER_URL=$(grep "^wrapperUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2)
    if [ -n "$WRAPPER_URL" ]; then
        if command -v curl > /dev/null 2>&1; then
            curl -fsSL -o "$MAVEN_WRAPPER_JAR" "$WRAPPER_URL"
        elif command -v wget > /dev/null 2>&1; then
            wget -q -O "$MAVEN_WRAPPER_JAR" "$WRAPPER_URL"
        fi
    fi
fi

exec "$JAVACMD" \
    -classpath "$MAVEN_WRAPPER_JAR" \
    "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
    org.apache.maven.wrapper.MavenWrapperMain "$@"
